# Número do WhatsApp para pareamento via Pairing Code (apenas dígitos com DDI+DDD, ex: 5511999999999)
# Se vazio, o bot exibe QR Code no log na primeira execução
PHONE_NUMBER=5511999999999

# JID do dono (fallback além de fromMe=true). Ex: 5511999999999@s.whatsapp.net
OWNER_JID=5511999999999@s.whatsapp.net

# Metadados EXIF fixos das figurinhas
STICKER_PACK=Meu Bot
STICKER_AUTHOR=Sávio

# Limites e performance (ajustados para Oracle VPS 2 vCPU / 12 GB RAM)
MAX_VIDEO_SECONDS=10
MAX_AUDIO_SECONDS=20
MAX_INPUT_MB=25
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=20
USER_COOLDOWN_MS=5000

# Armazenamento persistente (montado no volume Docker em /data)
DATA_DIR=./data
HEALTH_PORT=8080
LOG_LEVEL=info
